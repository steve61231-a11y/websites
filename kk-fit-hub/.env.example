# Copy to .env.local for development. In Vercel, set these per environment.
# NEXT_PUBLIC_* values are built into the pages: set them before `next build`.

# Supabase (Project settings → API). Without these the public site shows seed
# content and the forms and admin are unavailable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL, e.g. https://kkfithub.co.ke (Open Graph, sitemap, invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile. Test keys for previews: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA. Production keys before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email alerts via Resend: off until the domain is verified. Also switch on in
# Admin → Settings.
RESEND_API_KEY=
EMAIL_FROM=

# Protects /api/cron/* (Vercel Cron sends it automatically when set).
CRON_SECRET=

# Cookieless analytics (Plausible by default). Leave empty to disable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Optional: a self-hosted Plausible or Umami script URL.
NEXT_PUBLIC_ANALYTICS_SRC=

# Optional: salt for hashing rate-limit keys (defaults to the service role key).
RATE_LIMIT_SALT=
