{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/programmes",
        "http://localhost:3200/programmes/kenpo-karate",
        "http://localhost:3200/request"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
            "total-byte-weight": ["error", { "maxNumericValue": 1048576 }]
          }
        },
        {
          "matchingUrlPattern": "/(programmes|request)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "total-byte-weight": ["error", { "maxNumericValue": 614400 }]
          }
        },
        {
          "matchingUrlPattern": "/programmes",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "(:\\d+/$|/request$)",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median" }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
