# Copy to .env and fill in. NEVER commit .env.

# ── AI model ─────────────────────────────────────────────
# Leave OPENAI_API_KEY empty to run in heuristic mode (degraded briefing, no AI cost).
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (OpenRouter, Groq, Together, local Ollama…)
OPENAI_BASE_URL=
# Cheap model: filtering/classification. Analysis model: deep analysis + editor.
CHEAP_MODEL=gpt-5-mini
ANALYSIS_MODEL=gpt-5
# Optional: tried if the main model keeps failing
FALLBACK_MODEL=gpt-4.1-mini
# Optional for reasoning models: minimal | low | medium | high (low = cheaper/faster)
OPENAI_REASONING_EFFORT=low

# ── Email (SMTP) ─────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: use an App Password (Google Account → Security → App passwords), not your normal password
SMTP_PASSWORD=
EMAIL_FROM=Zenith Briefing <you@example.com>
# Comma-separated for several recipients
EMAIL_TO=you@example.com

# ── Schedule ─────────────────────────────────────────────
TIMEZONE=Africa/Nairobi
DAILY_RUN_TIME=06:30

# ── Storage ──────────────────────────────────────────────
# Local runs use a separate DB so they never conflict with the one GitHub Actions commits.
DATABASE_PATH=data/local.db

# ── Limits (optional overrides of config/settings.yaml) ──
# MAX_ARTICLES_DISCOVERED=500
# MAX_ARTICLES_EXTRACTED=100
# MAX_ARTICLES_DEEP_ANALYZED=20
# MAX_FINAL_STORIES=5

# ── Dashboard (required only if exposed beyond localhost) ──
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
