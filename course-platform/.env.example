# Copy to .env.local and fill in. Never commit real values.

# ---- Backend: database, payments, email (docs/BACKEND-SETUP.md) ---------------
# Leave the two Supabase lines empty and the site runs as the demo.

# Public (safe in the browser). Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://ozsvyxsrtgwnimhbrbss.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Same page, "service_role". Server only.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. Paystack > Settings > API Keys (sk_live_... or sk_test_...).
PAYSTACK_SECRET_KEY=
# SECRET. resend.com > API Keys.
RESEND_API_KEY=
# Must be on the domain verified in Resend.
MAIL_FROM=THE PROD <hello@yourdomain.com>
MAIL_REPLY_TO=
# Gets a short note for every purchase and booking.
NOTIFY_EMAIL=
# The public address of the site, no trailing slash.
SITE_URL=http://localhost:3000
# "1" once Google sign-in is switched on in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=
CAL_WEBHOOK_SECRET=

# ---- Protected video --------------------------------------------------------

# The one secret every video key, IV and file name is derived from. At least
# 32 characters. Use the SAME value as the VIDEO_SECRET secret of the GitHub
# Action that packages the videos. Changing it makes every packaged video
# unplayable until it is packaged again. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VIDEO_SECRET=

# Public URL of the storage bucket the encrypted segments are uploaded to
# (Cloudflare R2 public URL or a custom domain), with no trailing slash.
# The bucket can be public: every segment is encrypted and has an unguessable name.
VIDEO_CDN_URL=https://pub-847cb9382a4a49fa882600271ad98d9b.r2.dev

# "1" = anyone who opens a lesson gets a demo viewer and can watch protected
# videos, for testing before real sign-in exists. The server logs a loud
# warning while it is on. Leave empty for real students.
VIDEO_DEV_OPEN=

# VIDEO_DEV_OPEN is ignored in production unless this is also "1". Only for a
# short client test deploy; remove both straight after.
VIDEO_DEV_OPEN_IN_PRODUCTION=

# --- 1:1 session booking (docs/BOOKING-SETUP.md) ---------------------------
# Default: Duncan's Cal.com calendar. Its link lives in src/lib/catalog.ts (brand.session.calUrl).
# Phase 2: a Cal.com API key, to hand out single-use booking links after each payment.
CAL_API_KEY=

# Backup only (brand.session.provider = "own"): Duncan's Google Calendar, the site reads when he's busy and puts paid
# sessions on it with a Google Meet link. Without these, sessions are offered
# from the weekly hours in src/lib/catalog.ts and nothing is written to a calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar. Leave empty for his main one.
GOOGLE_CALENDAR_ID=

# "1" opens /api/booking/create so a session can be booked WITHOUT paying, to
# test the calendar link. Ignored in production unless the next line is "1" too.
BOOKING_DEV_OPEN=
BOOKING_DEV_OPEN_IN_PRODUCTION=
