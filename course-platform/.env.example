# Copy to .env.local and fill in. Never commit real values.

# ---- Protected video --------------------------------------------------------

# The one secret every video key, IV and file name is derived from. At least
# 32 characters. Use the SAME value as the VIDEO_SECRET secret of the GitHub
# Action that packages the videos. Changing it makes every packaged video
# unplayable until it is packaged again. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VIDEO_SECRET=

# Public URL of the storage bucket the encrypted segments are uploaded to
# (Cloudflare R2 public URL or a custom domain), with no trailing slash.
# The bucket can be public: every segment is encrypted and has an unguessable name.
VIDEO_CDN_URL=https://media.example.com

# "1" = anyone who opens a lesson gets a demo viewer and can watch protected
# videos, for testing before real sign-in exists. The server logs a loud
# warning while it is on. Leave empty for real students.
VIDEO_DEV_OPEN=

# VIDEO_DEV_OPEN is ignored in production unless this is also "1". Only for a
# short client test deploy; remove both straight after.
VIDEO_DEV_OPEN_IN_PRODUCTION=
