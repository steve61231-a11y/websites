# Higgsfield API credentials — create these in the Higgsfield console.
# Combined form ("KEY_ID:KEY_SECRET"), matching the official SDK's HF_CREDENTIALS:
HF_CREDENTIALS=your_key_id:your_key_secret

# ...or supply them separately instead of HF_CREDENTIALS:
# HF_API_KEY=your_key_id
# HF_API_SECRET=your_key_secret

# Optional overrides
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# PORT=3000

# Optional: public HTTPS URL of this server's /api/webhook route.
# When set, generation requests ask Higgsfield to call back on completion.
# HIGGSFIELD_WEBHOOK_URL=https://example.com/api/webhook
